[Unit]
Description=Stationery Member MySQL backup
After=mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/mnt/datadisk0/stationery-member/config/scripts/backup-database.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/datadisk0/stationery-member/backups/mysql
